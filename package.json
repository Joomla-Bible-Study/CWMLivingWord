{
  "name": "com_livingword",
  "version": "5.7.0-beta2",
  "description": "CWM LivingWord - frontend asset build pipeline (rollup JS, CSS minification, ESLint) and Playwright e2e/a11y/API tests",
  "license": "GPL-2.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Joomla-Bible-Study/CWMLivingWord.git"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "csso": "^5.0.5",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "rollup": "^4.62.4",
    "rollup-plugin-gzip": "^4.2.0"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:css": "SOURCE_DIR=build/media_source/css OUTPUT_DIR=media/com_livingword/css node libraries/vendor/cwm/build-tools/templates/build-css.js",
    "build:js": "SOURCE_DIR=build/media_source/js OUTPUT_DIR=media/com_livingword/js rollup -c libraries/vendor/cwm/build-tools/templates/rollup.config.js",
    "watch": "SOURCE_DIR=build/media_source/js OUTPUT_DIR=media/com_livingword/js rollup -c libraries/vendor/cwm/build-tools/templates/rollup.config.js -w",
    "lint:js": "eslint --max-warnings=0 .",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:api": "playwright test --project=api-test"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  }
}
